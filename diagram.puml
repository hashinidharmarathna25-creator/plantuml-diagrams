@startuml
left to right direction
skinparam packageStyle rectangle

' Actors
actor "Student (Kid)" as Student
actor "Instructor / Custom Role\n(TA, Mentor)" as Instructor
actor "Parent" as Parent
actor "Administrator" as Admin

actor "OAuth2 Provider" as OAuth2
actor "Redis Session Store" as Redis

' Subsystem Container
rectangle "Member 1: Security & Identity Subsystem (CSR STEM LMS)" {

    rectangle "Authentication & Profile" {
        usecase "Authenticate via Sequential Emoji/Visual PIN" as UC1
        usecase "Register Account" as UC2
        usecase "Verify Email via OTP" as UC3
        usecase "Manage User Profile & Security" as UC4
        usecase "Reset Password / Emoji PIN" as UC5
        usecase "Login via Email/Password or OAuth2" as UC6
    }

    rectangle "Parental Session & Linking Controls" {
        usecase "Set Concurrent Device Limits" as UC7
        usecase "Link Multiple Child Accounts" as UC8
        usecase "Configure Child Screen-Time Windows" as UC9
        usecase "Revoke Active Child Session" as UC10
        usecase "Blacklist JWT Token in Real-Time" as UC11
    }

    rectangle "Dynamic RBAC & ABAC Engine" {
        usecase "Evaluate Resource Access Request" as UC12
        usecase "Create Custom Dynamic Roles\n(TA, Mentor)" as UC13
        usecase "Define Contextual ABAC Rules\n(Time, Grade, Ownership)" as UC14
    }
}

' Include Relationships
UC3 .> UC2 : <<include>>
UC11 .> UC10 : <<include>>

' Student Associations
Student --> UC1
Student --> UC2
Student --> UC4
Student --> UC6

' Instructor Associations
Instructor --> UC1
Instructor --> UC2
Instructor --> UC4
Instructor --> UC6

' Parent Associations
Parent --> UC1
Parent --> UC2
Parent --> UC4
Parent --> UC6
Parent --> UC7
Parent --> UC8
Parent --> UC9

' Administrator Associations
Admin --> UC4
Admin --> UC10
Admin --> UC12
Admin --> UC13
Admin --> UC14

' External System Associations
UC6 --> OAuth2
UC12 --> Redis : Check Screen-Time & \nConcurrent Sessions

@enduml
